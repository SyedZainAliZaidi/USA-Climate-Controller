# Copy to .env and fill in. .env is gitignored — never commit the real key.

# --- app (server.js, client.js) ---
# Leave DEMO_MODE true to run the dashboard off the sample data in data/.
# Set it to false and fill in the two values below to run against the live API.
DEMO_MODE=true
FORTYGUARD_API_KEY=
FORTYGUARD_API_BASE=https://api.fortyguard.com

# --- verification scripts (npm run verify, npm run coverage) ---
FG_API_KEY=your_api_key_here
