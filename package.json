{
  "name": "environmental-health-monitoring-app",
  "version": "1.0.0",
  "description": "Heat risk alerts for outdoor workers, built on the FortyGuard heat data API.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/runTests.js",
    "generateSample": "node data/generateSample.js",
    "verify": "node scripts/verify-api.mjs",
    "verify:usage": "node scripts/verify-api.mjs --only=usage",
    "verify:rate": "node scripts/verify-api.mjs --rate-probe",
    "coverage": "node scripts/coverage-probe.mjs",
    "pdf": "node scripts/make-pdf.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18"
  }
}
